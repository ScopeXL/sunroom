# Sunroom Screen (a systemd user unit): the agent that runs the screen, its browser, its
# sleep and brightness and its own pages (docs/KIOSK.md). kiosk/install.sh copies it to
# ~/.config/systemd/user/. It is not enabled at boot: the desktop session starts it (the labwc
# autostart block, or an XDG autostart entry on X11) after importing WAYLAND_DISPLAY or
# DISPLAY, so the browser always has a screen to draw on.
# Its log: journalctl --user -u sunroom-kiosk

[Unit]
Description=Sunroom Screen (the wall screen)
After=graphical-session.target
# Never stop retrying: a wall screen has nobody to press "try again".
StartLimitIntervalSec=0

[Service]
Type=simple
# The agent (uv tool install puts it here); with no arguments it runs.
ExecStart=%h/.local/bin/sunroom-kiosk
# Started again 3 s after it fails. It watches the browser itself, so it only ends cleanly when
# stopped or when This Screen's Quit (on a computer) asks: then it stays off until next sign-in.
Restart=on-failure
RestartSec=3
# On stop it switches the screen back on (at full brightness) and closes the browser. The stop
# goes to the agent alone (mixed), which closes the browser through DevTools, the one close that
# writes a fresh pairing to disk; whatever is left is killed after (ADR 0040).
KillMode=mixed
TimeoutStopSec=20
