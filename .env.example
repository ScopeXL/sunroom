# Sunroom settings for local development. Copy to .env (`just setup` does this); never commit
# .env. Every setting is optional, in development and in production (docs/DEPLOY.md).

# A long random value (openssl rand -base64 48). Left empty, the server makes one and keeps it
# in DATA_DIR/secret.key. Changing it signs every device and screen out.
APP_SECRET_KEY=
# A household password that always wins over the one chosen in setup (8 characters or more).
# Left empty, the setup wizard asks for one.
APP_PASSWORD=
# Optional lock: answer only to these names (comma-separated, *.example.com works too) and
# local ones (localhost, *.local, *.lan, IP addresses). Empty, any name is answered, and a
# reverse proxy on the home network needs nothing at all (docs/REMOTE-ACCESS.md).
APP_ALLOWED_HOSTS=
# IANA time zone; the household can also pick one in the app.
TZ=America/New_York
PORT=8080
LOG_LEVEL=INFO
# Lets every account and photo library reach home-network addresses. Off; not needed: a parent's
# "This server is on your home network" tick allows that one server (PLAN §12.6).
SUNROOM_ALLOW_PRIVATE_URLS=false
# Development only (relative to backend/). In the container this is /data.
DATA_DIR=./.data
# Development only: the test endpoints under /api/_test (reset, seed, clock) for `just seed`
# and the end-to-end tests, answering this machine only. Refused inside the container.
# In test mode nothing asks the internet: the weather and the city search are made up (any
# city you type is "found" in Sample State). Take this line out to try the real ones.
SUNROOM_TEST_MODE=1
